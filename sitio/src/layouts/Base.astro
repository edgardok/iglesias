---
import { NOMBRE_SITIO } from '../lib/urls';
import Donar from '../components/Donar.astro';
interface Props { titulo: string; descripcion: string; jsonld?: unknown; ancho?: boolean; noindex?: boolean; canonicalExtra?: string; }
const { titulo, descripcion, jsonld, ancho = false, noindex = false, canonicalExtra = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname + canonicalExtra, Astro.site);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icono.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icono-192.png" />
  <meta name="theme-color" content="#7a3e1d" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Iglesias" />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1'} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={NOMBRE_SITIO} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <style is:global>
    :root { --tinta:#1b1b1b; --suave:#5b5b5b; --linea:#e4e2dc; --fondo:#faf9f6; --acento:#7a3e1d; }
    * { box-sizing:border-box }
    body { margin:0; font:16px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; color:var(--tinta); background:var(--fondo) }
    header, main, footer { max-width:860px; margin:0 auto; padding:0 1.25rem }
    header { display:flex; justify-content:space-between; align-items:center; padding-top:1rem; padding-bottom:1rem; border-bottom:1px solid var(--linea); flex-wrap:wrap; gap:.5rem }
    header a { color:var(--tinta); text-decoration:none; font-weight:600 }
    header nav a { margin-left:.9rem; font-weight:400; color:var(--suave) }
    @media (max-width:640px) { header nav a.menor { display:none } header nav a { margin-left:.7rem; font-size:.95rem } }
    main { padding-top:1.5rem; padding-bottom:3rem }
    main.ancho { max-width:none; padding:0 }
    h1 { font-size:1.75rem; line-height:1.2; margin:.25rem 0 .75rem }
    h2 { font-size:1.15rem; margin-top:2rem }
    a { color:var(--acento) }
    .migas { font-size:.9rem; color:var(--suave) } .migas a { color:var(--suave) }
    ul.lista { list-style:none; padding:0; margin:0 } ul.lista li { padding:.55rem 0; border-bottom:1px solid var(--linea) }
    ul.lista small { color:var(--suave); display:block }
    dl { display:grid; grid-template-columns:max-content 1fr; gap:.4rem 1.25rem } dt { color:var(--suave) } dd { margin:0 }
    .aviso { background:#fff; border:1px solid var(--linea); border-left:4px solid var(--acento); padding:.9rem 1rem; margin:1.5rem 0; border-radius:4px }
    .boton.secundario { background:transparent; color:var(--acento); border:1px solid var(--acento); margin-left:.5rem }
    .donar p { margin:.5rem 0 }
    .boton { display:inline-block; background:var(--acento); color:#fff; padding:.6rem 1rem; border-radius:6px; text-decoration:none; font-weight:600; border:0; cursor:pointer; font-size:1rem }
    .grilla { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:.5rem 1.5rem; padding:0; list-style:none }
    .gris { color:var(--suave) }
    .acciones-ficha { margin-top:2rem } .tarjetas-acciones { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:.75rem }
    .accion { display:block; background:#fff; border:1px solid var(--linea); border-left:4px solid var(--acento); border-radius:10px; padding:.9rem 1rem; text-decoration:none; color:var(--tinta) }
    .accion:hover { background:#f3ebe4 } .accion strong { display:block; color:var(--acento); margin-bottom:.2rem } .accion span { color:var(--suave); font-size:.92rem; line-height:1.4 }
    label { display:block; margin-top:1rem; font-weight:600 } input, textarea, select { width:100%; padding:.55rem; border:1px solid #c9c6bf; border-radius:6px; font:inherit; margin-top:.3rem }
    table { border-collapse:collapse; width:100% } td, th { text-align:left; padding:.4rem .5rem; border-bottom:1px solid var(--linea); vertical-align:top } th { color:var(--suave); font-weight:600 }
    footer { border-top:1px solid var(--linea); padding-top:1rem; padding-bottom:2rem; color:var(--suave); font-size:.9rem }
  </style>
</head>
<body>
  <header>
    <a href="/">{NOMBRE_SITIO}</a>
    <nav><a href="/cerca/">Cerca de mí</a><a href="/directorio/">Directorio</a><a href="/movimiento/" class="menor">El movimiento</a><a href="/sumarse/">Sumar mi iglesia</a><a href="/fuentes/" class="menor">Fuentes</a><a href="/apoyar/">Apoyar</a></nav>
  </header>
  <main class={ancho ? 'ancho' : ''}><slot /></main>
  <footer>
    <p>Directorio abierto de templos y comunidades de fe de habla hispana, construido con datos públicos de cada país y de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> (ODbL), completados por las propias iglesias. Coordenadas aproximadas de localidades: <a href="https://www.geonames.org/">GeoNames</a> (CC BY 4.0). <a href="/fuentes/">De dónde sale cada dato</a>.</p>
    <Donar compacto />
    <p>Los datos pueden estar desactualizados. Si una ficha es tuya, <a href="/sumarse/">reclamala y corregila</a>. Código y datos en <a href="https://github.com/edgardok/iglesias">GitHub</a>.</p>
  </footer>
</body>
</html>
