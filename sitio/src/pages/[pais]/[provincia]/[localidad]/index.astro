---
// Página de localidad: renderizada en el Worker desde D1.
export const prerender = false;
import Base from '../../../../layouts/Base.astro';
import { urlProvincia, urlPais, urlIglesiaDe, NOMBRE_SITIO } from '../../../../lib/urls';
import { db, iglesiasDeLocalidad, CACHE } from '../../../../lib/d1';
const POR_PAGINA = 150;
const { pais, provincia, localidad } = Astro.params;
const pag = Math.min(Math.max(parseInt(Astro.url.searchParams.get('p') ?? '1') || 1, 1), 5000);
const { total, lista } = await iglesiasDeLocalidad(db(Astro.locals), pais!, provincia!, localidad!, POR_PAGINA, (pag - 1) * POR_PAGINA);
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
if (!lista.length) return new Response('Localidad no encontrada', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
Astro.response.headers.set('Cache-Control', CACHE);
const p = { nombre: lista[0].pais, slug: pais! }, r = { nombre: lista[0].provincia, slug: provincia! }, l = { nombre: lista[0].localidad, slug: localidad! };
const porDen = new Map<string, number>();
for (const i of lista) porDen.set(i.denominacion ?? 'Sin clasificar', (porDen.get(i.denominacion ?? 'Sin clasificar') ?? 0) + 1);
const dens = [...porDen.entries()].sort((a, b) => b[1] - a[1]);
const sinUbicar = localidad === 'sin-localidad';
const detalle = paginas === 1 ? `: ${dens.slice(0, 6).map(([d, n]) => `${n} ${d.toLowerCase()}`).join(', ')}${dens.length > 6 ? ', entre otras' : ''}` : '';
const resumen = sinUbicar
  ? `Iglesias de ${r.nombre}, ${p.nombre}, cuya localidad todavía no pudimos determinar: ${total.toLocaleString('es')} fichas. Si es la tuya, reclamala y completá la ubicación.`
  : `En ${l.nombre}, ${r.nombre}, ${p.nombre}, este directorio registra ${total.toLocaleString('es')} ${total === 1 ? 'iglesia o comunidad de fe' : 'iglesias y comunidades de fe'}${detalle}.`;
const base = `/${p.slug}/${r.slug}/${l.slug}/`;
const enlace = (n: number) => n === 1 ? base : `${base}?p=${n}`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'ItemList', '@id': `${url}#lista`, name: `Iglesias en ${l.nombre}, ${r.nombre}, ${p.nombre}`, description: resumen, numberOfItems: total,
    itemListElement: lista.map((i, n) => ({ '@type': 'ListItem', position: (pag - 1) * POR_PAGINA + n + 1, url: new URL(urlIglesiaDe(i.pais_slug, i.slug), Astro.site).href, name: i.nombre })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: NOMBRE_SITIO, item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: p.nombre, item: new URL(urlPais(p.slug), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: r.nombre, item: new URL(urlProvincia(p.slug, r.slug), Astro.site).href },
    { '@type': 'ListItem', position: 4, name: l.nombre, item: url } ] } ] };
---
<Base titulo={`Iglesias en ${l.nombre}, ${r.nombre}, ${p.nombre}: ${total.toLocaleString('es')} templos y comunidades${pag > 1 ? ` (página ${pag})` : ''}`} descripcion={resumen.slice(0, 300)} jsonld={jsonld} noindex={sinUbicar} canonicalExtra={pag > 1 ? `?p=${pag}` : ''}>
  <nav class="migas" aria-label="Ubicación"><a href="/">Inicio</a> › <a href={urlPais(p.slug)}>{p.nombre}</a> › <a href={urlProvincia(p.slug, r.slug)}>{r.nombre}</a></nav>
  <h1>{sinUbicar ? `Iglesias de ${r.nombre} sin localidad` : `Iglesias en ${l.nombre}`}</h1>
  <p>{resumen}</p>
  <p>¿Falta la tuya o tiene datos viejos? <a href={`/sumarse/?pais=${p.slug}`}>Sumala o corregila</a>. Esta lista también está en <a href={`/${p.slug}/${r.slug}/${l.slug}.md${pag > 1 ? `?p=${pag}` : ''}`}>formato Markdown</a> para asistentes de IA.</p>
  {dens.length > 1 && <p><small>{dens.map(([d, n]) => `${d}: ${n}`).join(' · ')}</small></p>}
  {paginas > 1 && <p class="paginacion"><small>Página {pag} de {paginas}.</small> {pag > 1 && <a rel="prev" href={enlace(pag - 1)}>← Anterior</a>} {pag < paginas && <a rel="next" href={enlace(pag + 1)}>Siguiente →</a>}</p>}
  <ul class="lista">{lista.map(i => <li><a href={urlIglesiaDe(i.pais_slug, i.slug)}>{i.nombre}</a><small>{i.denominacion ?? 'Sin clasificar'}{i.direccion ? ` · ${i.direccion}` : ''}{i.horarios ? ` · ${i.horarios}` : ''}</small></li>)}</ul>
  {paginas > 1 && <p class="paginacion"><small>Página {pag} de {paginas}.</small> {pag > 1 && <a rel="prev" href={enlace(pag - 1)}>← Anterior</a>} {pag < paginas && <a rel="next" href={enlace(pag + 1)}>Siguiente →</a>}</p>}
</Base>
