---
import Base from '../../layouts/Base.astro';
import { provincias, localidadesDe, urlLocalidad } from '../../lib/datos';
export function getStaticPaths() { return provincias.map(p => ({ params: { provincia: p.slug }, props: { p } })); }
const { p } = Astro.props;
const locs = localidadesDe(p.slug);
---
<Base titulo={`Iglesias en ${p.nombre}: ${p.iglesias.length.toLocaleString('es-AR')} templos por localidad`} descripcion={`Templos, iglesias y comunidades de fe en la provincia de ${p.nombre}, ordenados por localidad. ${locs.length} localidades.`}>
  <p class="migas"><a href="/">Inicio</a> › <a href="/provincias/">Provincias</a></p>
  <h1>Iglesias en {p.nombre}</h1>
  <p>{p.iglesias.length.toLocaleString('es-AR')} fichas en {locs.length} localidades.</p>
  <ul class="grilla">{locs.map(l => <li><a href={urlLocalidad(p.slug, l.slug)}>{l.nombre}</a> <small>({l.iglesias.length})</small></li>)}</ul>
</Base>
