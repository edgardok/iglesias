---
import Base from '../layouts/Base.astro';
import { PAISES_LATAM } from '../lib/datos';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAAFXZf9Ea3xD7oeNy'; // clave pública (sitekey) del widget Turnstile 'iglesias'
---
<Base titulo="Sumar o reclamar mi iglesia | Iglesias de América Latina" descripcion="Formulario para sumar una iglesia de cualquier país de América Latina al directorio abierto, o reclamar y corregir una ficha existente. Gratis.">
  <h1 id="titulo">Sumá o reclamá tu iglesia</h1>
  <p id="intro">Contanos los datos de tu iglesia. Vale para cualquier país de América Latina, aunque todavía no tenga datos cargados. Un asistente revisa lo que llega, lo cruza con los registros públicos y publica la ficha. Nadie va a venderte nada: el directorio es gratis y abierto.</p>
  <form id="f" method="post" action="/api/sumarse">
    <input type="hidden" name="slug" id="slug" />
    <label>¿Qué necesitás? <select name="tipo" id="tipo" required>
      <option value="reclamar">Reclamar o completar la ficha de mi iglesia</option>
      <option value="nueva">Sumar una iglesia que no está en el directorio</option>
      <option value="cambio">Pedir un cambio, una corrección o ayuda</option>
      <option value="web">Quiero una web oficial para mi iglesia</option>
    </select></label>
    <label>País <select name="pais" id="pais" required>
      <option value="">Elegí</option>
      {PAISES_LATAM.map(p => <option value={p.slug}>{p.nombre}</option>)}
    </select></label>
    <p id="reclamo" hidden class="aviso">Estás reclamando la ficha <strong id="reclamo-slug"></strong>. Completá solo lo que quieras corregir o agregar.</p>
    <label>Nombre de la iglesia <input name="nombre" required maxlength="200" /></label>
    <label>Denominación o red <input name="denominacion" maxlength="200" placeholder="Ej.: Bautista, Asambleas de Dios, Pentecostal, independiente" /></label>
    <label>Dirección <input name="direccion" maxlength="200" /></label>
    <label>Localidad <input name="localidad" maxlength="120" /></label>
    <label>Provincia, departamento o estado <input name="provincia" maxlength="120" placeholder="Ej.: Buenos Aires, Antioquia, Jalisco" /></label>
    <label>Horarios de reunión <textarea name="horarios" rows="2" maxlength="500" placeholder="Ej.: Domingos 10:00 y 19:00, miércoles 20:00 oración"></textarea></label>
    <label>Teléfono o WhatsApp <input name="telefono" maxlength="40" /></label>
    <label>Email de contacto público <input name="email" type="email" maxlength="120" /></label>
    <label>Página de Facebook <input name="facebook" type="url" maxlength="300" placeholder="https://www.facebook.com/..." /></label>
    <label>Instagram <input name="instagram" type="url" maxlength="300" /></label>
    <label>Enlace de Google Maps <input name="google_maps" type="url" maxlength="500" placeholder="Pegá el link de 'Compartir' de Google Maps" /></label>
    <label>Sitio web <input name="web" type="url" maxlength="300" /></label>
    <label>Tu nombre y rol (no se publica) <input name="contacto_nombre" required maxlength="120" placeholder="Ej.: Juan Pérez, pastor" /></label>
    <label>Tu email (no se publica, para avisarte cuando esté publicada) <input name="contacto_email" type="email" required maxlength="120" /></label>
    <label id="lbl-comentario">Algo más que quieras contar <textarea name="comentario" id="comentario" rows="3" maxlength="1000"></textarea></label>
    <div class="cf-turnstile" data-sitekey={siteKey} data-language="es" style="margin-top:1rem"></div>
    <p><button class="boton" type="submit">Enviar</button></p>
    <p id="msj" role="status"></p>
  </form>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    const f = document.getElementById('f'), msj = document.getElementById('msj');
    const qs = new URLSearchParams(location.search); const slug = qs.get('slug'); const pais = qs.get('pais');
    if (pais) document.getElementById('pais').value = pais;
    const tipo = document.getElementById('tipo'), titulo = document.getElementById('titulo'), intro = document.getElementById('intro'), lblCom = document.getElementById('lbl-comentario'), com = document.getElementById('comentario');
    const opcionales = ['direccion', 'localidad', 'horarios'];
    const TEXTOS = {
      reclamar: ['Reclamá la ficha de tu iglesia', 'Completá lo que falte o corregí lo que esté mal. Un asistente lo revisa y lo publica; te avisamos por email.', 'Algo más que quieras contar'],
      nueva: ['Sumá tu iglesia al directorio', 'Contanos los datos de tu iglesia. Un asistente revisa lo que llega, lo cruza con los registros públicos y publica la ficha.', 'Algo más que quieras contar'],
      cambio: ['Pedí un cambio o ayuda', 'Contanos qué está mal o qué necesitás. Lo lee una persona y te responde por email.', 'Qué necesitás (obligatorio)'],
      web: ['Pedí una web oficial para tu iglesia', 'Te anotamos en la lista. Te escribimos para confirmar que sos de la iglesia y pedirte fotos y un texto de bienvenida. Es gratis.', 'Contanos de tu iglesia: cuánta gente, qué querrías mostrar, si ya tenés dominio o redes'],
    };
    function aplicarTipo() {
      const t = tipo.value, [h, p, c] = TEXTOS[t] || TEXTOS.reclamar;
      titulo.textContent = h; intro.textContent = p; lblCom.firstChild.textContent = c + ' ';
      const rec = document.getElementById('reclamo'); if (slug) { rec.hidden = false; rec.firstChild.textContent = t === 'reclamar' ? 'Estás reclamando la ficha ' : t === 'web' ? 'Pedido de web oficial para la ficha ' : 'Pedido sobre la ficha '; }
      const libre = t === 'cambio' || t === 'web';
      for (const n of opcionales) { const el = f.elements[n]; if (el) el.required = !libre && n === 'localidad'; }
      com.required = libre;
    }
    const tipoQs = qs.get('tipo'); if (tipoQs && TEXTOS[tipoQs]) tipo.value = tipoQs; else if (slug) tipo.value = 'reclamar'; else tipo.value = 'nueva';
    tipo.addEventListener('change', aplicarTipo);
    if (slug) { document.getElementById('slug').value = slug; document.getElementById('reclamo').hidden = false; document.getElementById('reclamo-slug').textContent = slug; }
    aplicarTipo();
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); msj.textContent = 'Enviando...';
      const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
      const j = await r.json().catch(() => ({}));
      if (r.ok) { const t = tipo.value; f.reset(); aplicarTipo(); msj.textContent = t === 'web' ? '¡Gracias! Quedaste en la lista. Te escribimos en los próximos días.' : t === 'cambio' ? '¡Gracias! Lo lee una persona y te responde por email.' : '¡Gracias! Recibimos los datos. Te avisamos por email cuando la ficha esté publicada.'; }
      else msj.textContent = j.error ?? 'No pudimos enviar el formulario. Probá de nuevo en un rato.';
    });
  </script>
</Base>
