---
import Base from '../../layouts/Base.astro';
import { iglesias, slugify } from '../../lib/datos';
const m = new Map<string, number>(); for (const i of iglesias) m.set(i.denominacion ?? 'Sin clasificar', (m.get(i.denominacion ?? 'Sin clasificar') ?? 0) + 1);
const tipos = [...m.entries()].sort((a, b) => b[1] - a[1]);
---
<Base titulo="Iglesias de Argentina por denominación y religión" descripcion={`Las ${iglesias.length.toLocaleString('es-AR')} fichas del directorio agrupadas por denominación: ${tipos.slice(0, 8).map(([d, n]) => `${d} (${n})`).join(', ')}.`}>
  <h1>Por tipo de comunidad</h1>
  <p>La denominación se toma de OpenStreetMap o se infiere del nombre de la entidad registrada; puede tener errores. Las iglesias pueden corregirla al reclamar su ficha.</p>
  <ul class="lista">{tipos.map(([d, n]) => <li><a href={`/tipo/${slugify(d)}/`}>{d}</a> <small>{n.toLocaleString('es-AR')} fichas</small></li>)}</ul>
</Base>
